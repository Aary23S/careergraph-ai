{
  "name": "careergraph-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "node --check src/app.js && node --check src/server.js && node --check src/start.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "jest --watch",
    "db:migrate": "sequelize-cli db:migrate --config src/config/database-cli.cjs --migrations-path src/database/migrations",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config src/config/database-cli.cjs --migrations-path src/database/migrations",
    "connections:backfill": "node scripts/backfill-connection-intelligence.js",
    "connections:validate": "node scripts/validate-connection-intelligence.js",
    "ai:benchmark": "node scripts/ai-benchmark.js",
    "ai:embedding:benchmark": "node scripts/ai-embedding-benchmark.js",
    "ai:evaluate": "node scripts/ai-evaluate.js",
    "worker:ai": "node src/workers/ai.worker.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "googleapis": "^176.0.0",
    "ioredis": "^6.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.1",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "sequelize-cli": "^6.6.2",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0"
  }
}
